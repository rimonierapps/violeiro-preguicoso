<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para conseguir abrir o Shazam e o SoundHound a partir do app (Android 11+) -->
    <queries>
        <package android:name="com.shazam.android" />
        <package android:name="com.melodis.midomiMusicIdentifier.freemium" />
        <package android:name="com.melodis.midomiMusicIdentifier" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play"
        android:label="Violeiro Preguiçoso v1"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Recebe o "Compartilhar" do Shazam, SoundHound, Spotify etc. -->
            <intent-filter android:label="Abrir cifra">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CifraActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".BuscaWebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".OuvinteService"
            android:exported="true"
            android:label="Violeiro Preguiçoso"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
